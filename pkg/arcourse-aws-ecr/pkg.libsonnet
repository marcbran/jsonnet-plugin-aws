local p = import 'pkg/main.libsonnet';

p.pkg({
  source: 'https://github.com/marcbran/jsonnet-plugin-aws/tree/main/pkg/arcourse-aws-ecr',
  repo: 'https://github.com/marcbran/jsonnet.git',
  branch: 'arcourse/aws/arcourse-aws-ecr',
  path: 'arcourse/aws/arcourse-aws-ecr',
  target: 'arcourse-aws-ecr',
  external: ['root'],
}, |||
  Arcourse nodes for Amazon Elastic Container Registry, below `aws/$account/$region/ecr`.

  Generated by jsonnet-aws from the plugin's Smithy model, its resource-tree rules and the
  overrides, columns and links in services/ecr/inference. The account and region nodes come from arcourse-aws.
|||, {})
