local p = import 'pkg/main.libsonnet';

p.pkg({
  source: 'https://github.com/marcbran/jsonnet-plugin-aws/tree/main/pkg/arcourse-aws-s3',
  repo: 'https://github.com/marcbran/jsonnet.git',
  branch: 'arcourse/aws/arcourse-aws-s3',
  path: 'arcourse/aws/arcourse-aws-s3',
  target: 'arcourse-aws-s3',
  external: ['root'],
}, |||
  Arcourse nodes for Amazon Simple Storage Service, below `aws/$account/$region/s3`.

  Generated by jsonnet-aws from the plugin's Smithy model, its resource-tree rules and the
  overrides, columns and links in services/s3/inference. The account and region nodes come from arcourse-aws.
|||, {})
