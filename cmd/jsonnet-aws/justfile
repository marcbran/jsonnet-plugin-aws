tool := "go tool -modfile=../../tools/go.mod"

test:
    go test ./...

lint:
    {{tool}} golangci-lint run ./...

build:
    go build -o jsonnet-aws .

install:
    dest=$(go env GOBIN); [ -n "$dest" ] || dest=$(go env GOPATH)/bin; go build -o "$dest/jsonnet-aws" .

test-e2e:
    JSONNET_AWS_BINARY="$(pwd)/jsonnet-aws" go test -v -tags e2e ./tests/...

ci: lint test build test-e2e
