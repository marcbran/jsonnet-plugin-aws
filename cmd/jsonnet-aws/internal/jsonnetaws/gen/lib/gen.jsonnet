local generateLib = import 'generate.libsonnet';
local mixins = importstr 'mixins.libsonnet';
local treeLib = import 'tree.libsonnet';

local packageName(service) = 'arcourse-aws-' + service;

local jsonnetfile = |||
  {
    "version": 1,
    "dependencies": [
      {
        "source": {
          "git": {
            "remote": "https://github.com/marcbran/jsonnet.git",
            "subdir": "arcourse/arcourse-ui"
          }
        },
        "version": "arcourse/arcourse-ui"
      }
    ],
    "legacyImports": true
  }
|||;

local pkg(service, title, global) = |||
  local p = import 'pkg/main.libsonnet';

  p.pkg({
    source: 'https://github.com/marcbran/jsonnet-plugin-aws/tree/main/pkg/%(name)s',
    repo: 'https://github.com/marcbran/jsonnet.git',
    branch: 'arcourse/aws/%(name)s',
    path: 'arcourse/aws/%(name)s',
    target: '%(name)s',
    external: ['root'],
  }, |||
    Arcourse nodes for %(title)s, below `%(base)s/%(service)s`.

    Generated by jsonnet-aws from the plugin's Smithy model, its resource-tree rules and the
    overrides, columns and links in services/%(service)s/inference. The %(scope)s nodes come from arcourse-aws.
  |||, {})
||| % {
  service: service,
  name: packageName(service),
  title: title,
  base: if global then 'aws/$account' else 'aws/$account/$region',
  scope: if global then 'account' else 'account and region',
};

function(service, model, resources, columns, links)
  local tree = treeLib {
    model:: model,
    overrides:: resources,
    columns:: columns,
  };
  local serviceShape = model.shapes[tree.service.id];
  local traits = std.get(serviceShape, 'traits', {});
  local title = std.get(traits, 'smithy.api#title', tree.service.sdkId);
  local global = std.objectHas(traits, 'jsonnetaws#global');
  {
    'main.libsonnet': generateLib {
      service:: service,
      tree:: tree,
      links:: links,
      global:: global,
    }.jsonnet,
    'pkg.libsonnet': pkg(service, title, global),
    'mixins.libsonnet': mixins,
    'jsonnetfile.json': jsonnetfile,
  }
