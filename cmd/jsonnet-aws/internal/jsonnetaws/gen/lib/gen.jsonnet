local generateLib = import 'generate.libsonnet';
local mixins = importstr 'mixins.libsonnet';
local treeLib = import 'tree.libsonnet';

local packageName(service) = 'arcourse-aws-' + service;

local pkg(service, title) = |||
  local p = import 'pkg/main.libsonnet';

  p.pkg({
    source: 'https://github.com/marcbran/jsonnet-plugin-aws/tree/main/services/%(service)s/arcourse',
    repo: 'https://github.com/marcbran/jsonnet.git',
    branch: 'arcourse/aws/%(name)s',
    path: 'arcourse/aws/%(name)s',
    target: '%(name)s',
    external: ['root', 'arcourse-ui/main.libsonnet'],
  }, |||
    Arcourse nodes for %(title)s, below `aws/$account/$region/%(service)s`.

    Generated by jsonnet-aws from the plugin's Smithy model, its resource-tree rules and the
    overrides, columns and links in ../inference. The account and region nodes come from arcourse-aws.
  |||, {})
||| % { service: service, name: packageName(service), title: title };

function(service, model, resources, columns, links)
  local tree = treeLib {
    model:: model,
    overrides:: resources,
    columns:: columns,
  };
  local serviceShape = model.shapes[tree.service.id];
  local title = std.get(std.get(serviceShape, 'traits', {}), 'smithy.api#title', tree.service.sdkId);
  {
    'main.libsonnet': generateLib {
      service:: service,
      tree:: tree,
      links:: links,
    }.jsonnet,
    'pkg.libsonnet': pkg(service, title),
    'mixins.libsonnet': mixins,
  }
