local p = import 'pkg/main.libsonnet';

p.pkg({
  source: 'https://github.com/marcbran/jsonnet-plugin-aws/tree/main/services/ec2/arcourse',
  repo: 'https://github.com/marcbran/jsonnet.git',
  branch: 'arcourse/aws/arcourse-aws-ec2',
  path: 'arcourse/aws/arcourse-aws-ec2',
  target: 'arcourse-aws-ec2',
  external: ['root', 'arcourse-ui/main.libsonnet'],
}, |||
  Arcourse nodes for Amazon Elastic Compute Cloud, below `aws/$account/$region/ec2`.

  Generated by jsonnet-aws from the plugin's Smithy model, its resource-tree rules and the
  overrides, columns and links in ../inference. The account and region nodes come from arcourse-aws.
|||, {})
